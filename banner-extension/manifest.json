{
  "manifest_version": 3,
  "name": "VPN Chrome Banner",
  "version": "1.1.0",
  "description": "Shows a persistent VPN marker and blocks WebRTC IP leaks in the VPN Chrome profile.",
  "permissions": ["privacy"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
