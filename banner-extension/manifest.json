{
  "manifest_version": 3,
  "name": "VPN Chrome",
  "version": "1.2.0",
  "description": "Shows a persistent VPN marker and blocks WebRTC IP leaks in the VPN Chrome profile.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["privacy"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
